[gd_scene load_steps=3 format=3]

[ext_resource type="PackedScene" uid="uid://phase4gameover" path="res://scenes/ui/game_over_ui.tscn" id="1_game_over"]

[sub_resource type="GDScript" id="GDScript_test"]
script/source = "extends Node2D

func _ready() -> void:
	# Add background
	var bg = ColorRect.new()
	bg.color = Color(0.1, 0.4, 0.1)  # Dark green like grass
	bg.set_anchors_preset(Control.PRESET_FULL_RECT)
	add_child(bg)
	move_child(bg, 0)

	# Set test stats
	var test_stats = {
		\"survival_time\": 185.5,
		\"kills\": 47,
		\"highest_level\": 6,
		\"highest_wave\": 4,
	}

	$GameOverUI.set_stats(test_stats)
	$GameOverUI.show_game_over()

	# Unpause for display
	get_tree().paused = false
"

[node name="TestScene" type="Node2D"]
script = SubResource("GDScript_test")

[node name="GameOverUI" parent="." instance=ExtResource("1_game_over")]
